PROJECT_NAME           = "Ensign"
PROJECT_BRIEF          = "Low-rank framework for multi-core CPUs and GPUs"
OUTPUT_DIRECTORY       = docs/doxygen
INPUT                  = include docs/doxygen-mainpage.md
FILE_PATTERNS          = *.hpp
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = docs/doxygen-mainpage.md
INPUT_FILTER           = "sh scripts/doxygen_filter.sh"
FILTER_PATTERNS        =
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
SORT_GROUP_NAMES       = NO
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
MARKDOWN_SUPPORT       = YES
GENERATE_HTML          = YES
HTML_OUTPUT            = .
USE_MATHJAX            = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = YES
HTML_COLORSTYLE        = LIGHT
HTML_EXTRA_STYLESHEET  = docs-theme/doxygen-awesome.css docs-theme/doxygen-awesome-sidebar-only.css
LAYOUT_FILE            = DoxygenLayout.xml
DISABLE_INDEX          = NO
HTML_DYNAMIC_SECTIONS  = YES
HTML_COLORSTYLE_HUE    = 230
SOURCE_BROWSER         = YES
HAVE_DOT               = NO
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
MACRO_EXPANSION        = YES
PREDEFINED             = __OPENMP__
